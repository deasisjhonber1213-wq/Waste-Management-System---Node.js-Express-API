# Server Configuration
PORT=5000
NODE_ENV=production

# Railway MySQL Database (provided by Railway)
MYSQLHOST=mysql.railway.internal
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=BYrNTduIFMPfoZRtCLBzWHKRLFcmUASh
MYSQLDATABASE=railway

# Alternative format
DATABASE_URL=mysql://root:BYrNTduIFMPfoZRtCLBzWHKRLFcmUASh@mysql.railway.internal:3306/railway

# JWT Security
JWT_SECRET=change-this-to-a-very-long-random-string-here
SESSION_SECRET=change-this-to-another-long-random-string-here

# CORS
CORS_ORIGIN=https://your-app-name.railway.app

# Setup Secrets (Change these!)
MIGRATION_SECRET=your-migration-secret-change-this
SETUP_SECRET=your-setup-secret-change-this

# Cookie Domain (for Railway)
COOKIE_DOMAIN=.railway.app

# Production Settings
ALLOW_SETUP_IN_PROD=false

# Optional: Database Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT=30000